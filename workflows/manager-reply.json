            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Persist Manager Communication": {
      "main": [
        [
          {
            "node": "Send Manager Reply to Client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
